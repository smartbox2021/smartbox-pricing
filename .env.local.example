# Email settings — fill these in before deploying
# Use a Gmail account with an App Password enabled
# Guide: myaccount.google.com → Security → App passwords

GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Recipients
EMAIL_TO=alex@smartboxselfstorage.uk,roger@smartboxselfstorage.uk

# Secret key to protect the scrape trigger endpoint
# Make this something random e.g. "smartbox-corby-2026"
CRON_SECRET=your-secret-here
